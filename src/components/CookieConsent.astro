---
// Consent banner + settings dialog (AEPD guidance: reject as prominent as accept, nothing optional
// loads before a choice, choice can be changed any time from the footer). Only optional category: analytics (Umami).
import { analytics, consentConfig } from '../config';
import { getLang, routePath } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = ui[lang].consent;
const cookiesHref = routePath('cookies', lang);
---
<div class="cc-banner" id="cc-banner" role="region" aria-labelledby="cc-title" hidden
  data-key={consentConfig.storageKey} data-version={consentConfig.version} data-max-age={consentConfig.maxAgeDays}
  data-umami-id={analytics.umamiWebsiteId} data-umami-src={analytics.umamiSrc}>
  <p class="cc-title" id="cc-title">{t.title}</p>
  <p class="cc-text">{t.text} <a href={cookiesHref}>{t.more}</a></p>
  <div class="cc-actions">
    <button type="button" class="cc-btn" data-cc="reject">{t.rejectAll}</button>
    <button type="button" class="cc-btn" data-cc="accept">{t.acceptAll}</button>
    <button type="button" class="cc-link" data-cc="configure">{t.configure}</button>
  </div>
</div>

<dialog class="cc-dialog" id="cc-dialog" aria-labelledby="cc-dialog-title">
  <form method="dialog" class="cc-dialog-inner">
    <div class="cc-dialog-head">
      <h2 id="cc-dialog-title">{t.settingsTitle}</h2>
      <button type="submit" class="cc-close" value="close" aria-label={t.close}>×</button>
    </div>
    <p class="cc-text">{t.settingsText} <a href={cookiesHref}>{t.more}</a></p>

    <div class="cc-cat">
      <div>
        <p class="cc-cat-title">{t.necessaryTitle}</p>
        <p class="cc-cat-text">{t.necessaryText}</p>
      </div>
      <span class="cc-always">{t.alwaysOn}</span>
    </div>
    <div class="cc-cat">
      <div>
        <p class="cc-cat-title" id="cc-analytics-label">{t.analyticsTitle}</p>
        <p class="cc-cat-text" id="cc-analytics-desc">{t.analyticsText}</p>
      </div>
      <input type="checkbox" class="cc-switch" id="cc-analytics" role="switch" aria-labelledby="cc-analytics-label" aria-describedby="cc-analytics-desc" />
    </div>

    <div class="cc-actions">
      <button type="button" class="cc-btn" data-cc="reject">{t.rejectAll}</button>
      <button type="button" class="cc-btn" data-cc="accept">{t.acceptAll}</button>
      <button type="button" class="cc-btn cc-save" data-cc="save">{t.save}</button>
    </div>
  </form>
</dialog>

<style>
  .cc-banner {
    position: fixed; left: 22px; bottom: 22px; z-index: 60; max-width: 460px;
    background: rgba(14,20,38,0.96); backdrop-filter: blur(16px); border: 1px solid var(--line-bright);
    border-radius: 16px; padding: 22px 22px 18px; box-shadow: 0 24px 60px -20px rgba(0,0,0,0.8);
  }
  .cc-banner[hidden] { display: none; }
  .cc-title { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; margin-bottom: 6px; }
  .cc-text { font-size: 0.9rem; color: var(--text-2); line-height: 1.55; }
  .cc-text a { color: var(--gs-blue-bright); text-decoration: underline; text-underline-offset: 3px; }
  .cc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
  /* Accept and reject share the same style on purpose (equal prominence) */
  .cc-btn {
    font: inherit; font-family: var(--font-display); font-weight: 500; font-size: 0.9rem; cursor: pointer;
    padding: 10px 18px; border-radius: 10px; color: var(--text); background: rgba(255,255,255,0.04);
    border: 1px solid var(--line-bright); transition: 0.25s var(--ease);
  }
  .cc-btn:hover { border-color: var(--gs-blue-bright); color: var(--gs-blue-bright); background: rgba(30,91,255,0.08); }
  .cc-save { background: linear-gradient(135deg, var(--gs-blue), var(--gs-blue-deep)); border-color: transparent; color: #fff; }
  .cc-save:hover { color: #fff; }
  .cc-link { font: inherit; font-size: 0.9rem; background: none; border: none; color: var(--text-2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: 10px 4px; }
  .cc-link:hover { color: var(--text); }

  .cc-dialog {
    margin: auto; width: min(560px, calc(100vw - 32px)); padding: 0; color: var(--text);
    background: var(--surface); border: 1px solid var(--line-bright); border-radius: 18px; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.85);
  }
  .cc-dialog::backdrop { background: rgba(6,9,18,0.7); backdrop-filter: blur(4px); }
  .cc-dialog-inner { padding: 28px; }
  .cc-dialog-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .cc-dialog h2 { font-size: 1.3rem; }
  .cc-close { font-size: 1.6rem; line-height: 1; background: none; border: none; color: var(--text-2); cursor: pointer; padding: 4px 8px; border-radius: 8px; }
  .cc-close:hover { color: var(--text); }
  .cc-cat { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 16px 0; border-top: 1px solid var(--line); margin-top: 14px; }
  .cc-cat + .cc-cat { margin-top: 0; }
  .cc-cat-title { font-weight: 600; font-size: 0.98rem; }
  .cc-cat-text { font-size: 0.86rem; color: var(--text-3); }
  .cc-always { font-size: 0.8rem; color: var(--gs-cyan); white-space: nowrap; }
  .cc-switch {
    appearance: none; flex-shrink: 0; width: 46px; height: 26px; border-radius: 26px; cursor: pointer; position: relative;
    background: var(--surface-2); border: 1px solid var(--line-bright); transition: background 0.25s;
  }
  .cc-switch::after {
    content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%;
    background: var(--text-2); transition: transform 0.25s var(--ease), background 0.25s;
  }
  .cc-switch:checked { background: var(--gs-blue); border-color: var(--gs-blue); }
  .cc-switch:checked::after { transform: translateX(20px); background: #fff; }
  @media (max-width: 560px) {
    .cc-banner { left: 12px; right: 12px; bottom: 12px; max-width: none; }
  }
</style>

<script>
  interface Consent { v: number; ts: number; analytics: boolean; }

  const banner = document.getElementById('cc-banner');
  const dialog = document.getElementById('cc-dialog') as HTMLDialogElement | null;
  const analyticsInput = document.getElementById('cc-analytics') as HTMLInputElement | null;

  if (banner && dialog && analyticsInput) {
    const cfg = banner.dataset;
    const key = cfg.key ?? 'gs-consent';
    const version = Number(cfg.version ?? 1);
    const maxAgeMs = Number(cfg.maxAge ?? 365) * 24 * 60 * 60 * 1000;
    let analyticsLoaded = false;

    const read = (): Consent | null => {
      try {
        const c = JSON.parse(localStorage.getItem(key) ?? 'null') as Consent | null;
        return c && c.v === version && Date.now() - c.ts < maxAgeMs ? c : null;
      } catch { return null; }
    };
    const write = (c: Consent) => { try { localStorage.setItem(key, JSON.stringify(c)); } catch { /* storage blocked: ask again next visit */ } };

    const loadAnalytics = () => {
      if (analyticsLoaded || !cfg.umamiId || !cfg.umamiSrc) return;
      const s = document.createElement('script');
      s.defer = true;
      s.src = cfg.umamiSrc;
      s.dataset.websiteId = cfg.umamiId;
      document.head.append(s);
      analyticsLoaded = true;
    };

    const apply = (c: Consent) => {
      if (c.analytics) loadAnalytics();
      // A loaded tracker can't be unloaded: reload so the withdrawal takes effect immediately
      else if (analyticsLoaded) location.reload();
    };

    const decide = (analytics: boolean) => {
      const c: Consent = { v: version, ts: Date.now(), analytics };
      write(c);
      banner.hidden = true;
      if (dialog.open) dialog.close();
      apply(c);
    };

    const openSettings = () => {
      analyticsInput.checked = read()?.analytics ?? false;
      dialog.showModal();
    };

    document.addEventListener('click', (e) => {
      const target = (e.target as Element).closest<HTMLElement>('[data-cc], [data-cc-open]');
      if (!target) return;
      if (target.hasAttribute('data-cc-open')) { e.preventDefault(); openSettings(); return; }
      const action = target.dataset.cc;
      if (action === 'accept') decide(true);
      else if (action === 'reject') decide(false);
      else if (action === 'save') decide(analyticsInput.checked);
      else if (action === 'configure') openSettings();
    });

    const existing = read();
    if (existing) apply(existing);
    else banner.hidden = false;
  }
</script>
