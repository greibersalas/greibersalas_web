---
// "About me" section. The portrait is an SVG placeholder until a real photo is provided:
// replace <svg class="avatar"> with <Image src={photo} ... /> from astro:assets.
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = ui[lang].about;
---
<section id={ui[lang].ids.about} class="about-sec">
  <div class="container about">
    <div class="portrait reveal">
      <div class="portrait-frame">
        <svg class="avatar" viewBox="0 0 320 380" role="img" aria-label={t.photoAlt}>
          <defs>
            <linearGradient id="av-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#0e1426" />
              <stop offset="1" stop-color="#002E83" />
            </linearGradient>
            <linearGradient id="av-fig" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4d82ff" />
              <stop offset="1" stop-color="#1e5bff" stop-opacity="0.55" />
            </linearGradient>
            <pattern id="av-grid" width="32" height="32" patternUnits="userSpaceOnUse">
              <path d="M32 0H0v32" fill="none" stroke="rgba(120,145,210,0.14)" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="320" height="380" fill="url(#av-bg)" />
          <rect width="320" height="380" fill="url(#av-grid)" />
          <circle cx="160" cy="150" r="118" fill="none" stroke="#38e0ff" stroke-opacity="0.25" stroke-dasharray="4 8" />
          <!-- Head and shoulders silhouette -->
          <circle cx="160" cy="138" r="56" fill="url(#av-fig)" />
          <path d="M52 380c0-72 48-124 108-124s108 52 108 124Z" fill="url(#av-fig)" />
          <text x="160" y="148" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="26" font-weight="700" fill="#eef2fb">&lt;GS/&gt;</text>
        </svg>
      </div>
      <div class="portrait-badge mono" aria-hidden="true">full-stack · dev</div>
    </div>

    <div class="about-body">
      <span class="tag-label reveal">{t.tag}</span>
      <h2 class="sec-title reveal">{t.title}</h2>
      {t.paragraphs.map((p) => <p class="about-p reveal">{p}</p>)}
      <ul class="highlights reveal">
        {t.highlights.map((h) => (
          <li><strong>{h.title}</strong><span>{h.text}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .about { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 72px; align-items: center; }
  .portrait { position: relative; max-width: 380px; }
  .portrait-frame {
    border-radius: 24px; overflow: hidden; border: 1px solid var(--line-bright);
    box-shadow: 0 30px 80px -30px rgba(0,0,0,0.8), 0 0 0 1px rgba(30,91,255,0.12);
  }
  .avatar { display: block; width: 100%; height: auto; }
  .portrait-badge {
    position: absolute; right: -14px; bottom: 28px; font-size: 0.75rem; letter-spacing: 0.06em; color: var(--gs-cyan);
    background: rgba(14,20,38,0.9); backdrop-filter: blur(12px); border: 1px solid var(--line-bright); border-radius: 10px; padding: 9px 14px;
  }
  .about-body .sec-title { max-width: 560px; }
  .about-p { color: var(--text-2); font-size: 1.05rem; margin-bottom: 16px; max-width: 620px; }
  .highlights { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 30px; }
  .highlights li { border-top: 2px solid var(--gs-blue); padding-top: 14px; }
  .highlights strong { display: block; font-family: var(--font-display); font-weight: 600; margin-bottom: 4px; }
  .highlights span { font-size: 0.92rem; color: var(--text-3); }
  @media (max-width: 920px) {
    .about { grid-template-columns: 1fr; gap: 48px; }
    .portrait { max-width: 300px; }
  }
  @media (max-width: 600px) { .highlights { grid-template-columns: 1fr; } }
</style>
