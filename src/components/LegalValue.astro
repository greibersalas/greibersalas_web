---
// Renders a legal identity value, or a highlighted "pending" marker when it is not configured yet.
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props { value: string; }
const { value } = Astro.props;
const pending = ui[getLang(Astro.currentLocale)].legal.pending;
---
{value ? <span>{value}</span> : <span class="pending">{pending}</span>}
