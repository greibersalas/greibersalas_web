---
import Logo from './Logo.astro';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = ui[lang].contact;
const [titleFirst, titleSecond] = t.titleLines;
---
<section id={ui[lang].ids.contact} class="cta">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="container cta-inner reveal">
    <div class="brand-big"><Logo height={48} alt="" /></div>
    <h2>{titleFirst}<br/>{titleSecond}</h2>
    <p>{t.text}</p>
    <div class="cta-actions">
      <a href="mailto:greibersalas@gmail.com" class="btn btn-primary">greibersalas@gmail.com</a>
      <a href="https://www.linkedin.com/in/greibersalas/" target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; text-align: center; overflow: hidden; padding: 140px 0; }
  .cta-glow { position: absolute; inset: 0; background: radial-gradient(700px 400px at 50% 50%, rgba(30,91,255,0.18), transparent 65%); }
  .cta-inner { max-width: 700px; position: relative; }
  .brand-big { display: flex; justify-content: center; margin-bottom: 28px; filter: drop-shadow(0 0 24px rgba(30,91,255,0.55)); }
  .cta h2 { font-size: clamp(2.4rem, 6vw, 4rem); }
  .cta p { color: var(--text-2); margin: 20px auto 40px; max-width: 480px; font-size: 1.1rem; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
