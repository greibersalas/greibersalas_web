---
// Imported in frontmatter so the stylesheet stays global (a <style> block would be scoped to this layout)
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Greiber Salas — Ingeniería de Software a Medida',
  description = 'Desarrollador full-stack senior. Diseño y construyo plataformas SaaS, portales B2B y productos digitales con Angular, NestJS y arquitectura de nivel producción.',
  noindex = false,
} = Astro.props;

const site = Astro.site?.origin ?? 'https://greibersalas.com';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/og-image.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Greiber Salas',
  url: site,
  image: ogImage,
  email: 'mailto:hola@greibersalas.com',
  jobTitle: 'Software Developer',
  description,
  sameAs: ['https://www.linkedin.com/in/greibersalas/'],
  knowsAbout: ['Angular', 'NestJS', 'PHP', 'PostgreSQL', 'MySQL', 'Arquitectura de software'],
};
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#060912" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Preload the fonts used above the fold (body text + headings) -->
  <link rel="preload" href="/fonts/Satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ClashDisplay-600.woff2" as="font" type="font/woff2" crossorigin />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main" class="skip-link">Saltar al contenido</a>
  <slot />
  <script>
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
  </script>
</body>
</html>
