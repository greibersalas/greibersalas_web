---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Página no encontrada — Greiber Salas" description="La página que buscas no existe." noindex>
  <main id="main" tabindex="-1" class="nf">
    <div class="container nf-inner">
      <a href="/" class="brand-big mono" aria-label="Greiber Salas — inicio">&lt;GS/&gt;</a>
      <p class="nf-code mono">404</p>
      <h1>Esta página no existe</h1>
      <p class="nf-text">Puede que el enlace esté roto o que la página se haya movido.</p>
      <a href="/" class="btn btn-primary">Volver al inicio →</a>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .nf { min-height: calc(100vh - 110px); display: grid; place-items: center; text-align: center; position: relative; z-index: 1; }
  .nf-inner { max-width: 620px; padding-top: 80px; padding-bottom: 80px; }
  .brand-big { display: inline-block; font-size: 2rem; font-weight: 700; color: var(--gs-blue-bright); margin-bottom: 32px; }
  .nf-code { font-size: 0.9rem; letter-spacing: 0.1em; color: var(--gs-cyan); }
  .nf h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 12px 0 18px; }
  .nf-text { color: var(--text-2); margin-bottom: 36px; font-size: 1.1rem; }
</style>
